// @prisma\schema.prisma
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map(name: "created_at")
  updatedAt         DateTime @default(now()) @map(name: "updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map(name: "accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map(name: "sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now()) @map(name: "created_at")
  updatedAt     DateTime  @default(now()) @map(name: "updated_at")
  role          UserRole  @default(USER)
  savedAds      SavedAd[]

  
  accounts Account[]
  sessions Session[]

 

  stripeCustomerId       String?   @unique @map(name: "stripe_customer_id")
  stripeSubscriptionId   String?   @unique @map(name: "stripe_subscription_id")
  stripePriceId          String?   @map(name: "stripe_price_id")
  stripeCurrentPeriodEnd DateTime? @map(name: "stripe_current_period_end")

  @@map(name: "users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map(name: "verification_tokens")
}



model SavedAd {
  id            String    @id @default(cuid())
  ad_archive_id String
  board         String
  adData        Json     // ✅ This will now store the JSON with R2 URLs
  imageUrl      String?  // ✅ This might store an R2 URL for the preview image
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
 
  // Index for faster queries by user
  @@index([userId])
// Index for faster querying by board name
  @@index([board])
  // Unique constraint to prevent duplicate saves
  @@unique([userId, ad_archive_id, board])
}

model MetaGraphQLConfig {
  id          String   @id @default(cuid())
  graphql_xhr Json     @db.JsonB // 🚀 Binary JSON storage
  is_active   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // 🔍 Query optimization indexes
  @@index([is_active], name: "config_active_idx")
  @@index([createdAt], name: "config_created_at_idx")
  
  // 📈 Storage optimizations
  @@map(name: "meta_graphql_configs")
  /// "Stores GraphQL XHR configurations for Meta API interactions"
}


// ========================================
//        ✨ Stores Model ✨
// ========================================
model Store {
  id       String   @id @default(uuid())
  image    String
  name     String
  niche    String
  link     String
  revenue  Float
  sales    Int
  CTA      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([niche])
  @@index([revenue])
  @@index([sales])
}

// ========================================
//        📦 Product Model 📦
// ========================================
model Product {
  
  id String @id @default(cuid())// ✨ Unique identifier for the product (using CUID)
  image String// 🖼️ URL of the product image
  title String  // 🏷️ Title or name of the product
  niche String?  // 틈️ Niche or category of the product (optional)
  link String  // 🔗 Direct link to the product page or source
  uploadDate DateTime?  // 📅 Date when the product was added/uploaded (optional)
  stars Float?  // ⭐ Star rating out of 5 (optional)
  buyPrice Float?  // 💰 Price to buy the product (optional)
  sellPrice Float?  // 💲 Price to sell the product (optional)
  totalSales Int?  // 📈 Estimated total sales per month (optional)
  countries String[]  // 🌍 List of countries where the product is relevant/available (optional)  // Stored as an array of strings



  createdAt DateTime @default(now())  // 🕰️ Timestamp when the product record was created
  updatedAt DateTime @updatedAt  // 🕰️ Timestamp when the product record was last updated


  // --- Indexes ---
  @@index([title])  // 🔍 Index for faster searching/filtering by title
  @@index([niche])  // 🔍 Index for faster searching/filtering by niche
  @@index([createdAt])  // 🕒 Index for sorting by creation date

}




model MetaGraphQLRequest {
  id              String   @id @default(cuid())

  // General Identification
  name            String                       // e.g. "ad_search", can have duplicates
  friendly_name   String?                      // Optional human-friendly label
  doc_id          String?                      // Meta GraphQL doc_id (if available)

  // The copied raw request structure (url, method, requestHeaders, requestBody, etc.)
  base_request    Json                         // Full request configuration as JSON

  // Map of "alias → JSONPath" to extract values from Meta response
  fields_to_extract Json                       // Example: {"ad_id": "$.data.viewer.ads[*].id"}

  // Activation / Status
  is_active       Boolean   @default(true)

  // Timestamps
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
}
